# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Enterprise AppSec Configuration (OWASP Top 10) ---
# DB_ENCRYPTION_KEY: 256-bit Hex string (64 hex characters) used for AES-256-GCM database field encryption at rest.
# If not specified, an auto-generated cryptographically secure key is generated and stored in data/keys/db_master.key
DB_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# SESSION_SECRET: Cryptographic salt/secret used for signing HttpOnly SameSite=Strict session cookies.
SESSION_SECRET="budgettech_enterprise_appsec_secret_change_in_production_88219"

# NODE_ENV: Set to 'production' in live deployments for strict HTTPS, HSTS, and secure cookie enforcement.
NODE_ENV="production"

# PORT: Web server listening port (Default: 3000)
PORT="3000"

# --- SMTP Transactional Email Configuration (Optional for Live Production Email Verification) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="security@budgettech.cyber"
SMTP_PASS="secure_smtp_password"
SMTP_FROM="\"BudgetTech Security\" <no-reply@budgettech.cyber>"

